# Instance root — NOT the REST base. No trailing /rest, no trailing slash.
#
# On macOS 15+, if the instance is on a private address (192.168.x.x, a .local
# hostname), the app running this server needs Local Network permission or every
# request fails with 'No route to host'. Pointing at 127.0.0.1 avoids that entirely —
# loopback is exempt.
SUGAR_URL=https://sugar.example.com

# Sugar has no service accounts (client_credentials is not implemented), so the server
# logs in as a real user and inherits that user's ACLs.
SUGAR_USERNAME=

# Leave SUGAR_PASSWORD blank to keep it out of this file entirely, and store it in the OS
# keychain instead:   uv run scripts/set_credentials.py
# The environment takes precedence over the keychain when both are set.
SUGAR_PASSWORD=

# A dedicated platform keeps the server from evicting the user's browser session:
# SugarOAuth2StorageBase allows one session per platform, so logging in on 'base' logs
# them out of the web UI. Requires the SugarMCP package to register 'mcp'; without it the
# server warns and falls back to 'base'.
SUGAR_PLATFORM=mcp

# The OAuth key for a custom platform must have client_type='user'. Falls back to the
# auto-created 'sugar' key if this one is rejected.
SUGAR_CLIENT_ID=mcp
SUGAR_CLIENT_SECRET=

# Highest version on Sugar 26.1. Negotiated down automatically on a 301 incorrect_version.
SUGAR_API_VERSION=v11_27

# Set to 1 to omit the write tools from registration entirely — they are not merely
# refused at call time, they never appear in the tool list.
SUGAR_READ_ONLY=

# Default page size for list results, and the hard ceiling a caller may request.
SUGAR_MAX_RECORDS=20
SUGAR_MAX_RECORDS_CEILING=100

# Token and metadata cache root. Tokens are written 0600 — the access token IS the PHP
# session id, so treat the file as a credential.
SUGAR_CACHE_DIR=~/.sugarmcp

# Set to 0 for a local instance with a self-signed certificate.
SUGAR_VERIFY_SSL=1

# Per-request timeout in seconds.
SUGAR_TIMEOUT=60

# ---------------------------------------------------------------------------
# Transport (stdio for local dev, http for remote / containerized hosting)
# ---------------------------------------------------------------------------

# stdio (default) runs over the client's stdin/stdout, as Claude Desktop launches it.
# http runs a streamable-HTTP server (for remote hosting / custom connectors). Also
# selectable with the --http / --stdio flag.
MCP_TRANSPORT=stdio

# HTTP bind address and port. 0.0.0.0 inside a container; 127.0.0.1 if you terminate TLS
# with a reverse proxy on the same host. The MCP endpoint is served at MCP_HTTP_PATH.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp

# Static bearer token for the HTTP transport. REQUIRED for http unless MCP_ALLOW_ANONYMOUS=1
# — the server refuses to start otherwise. The connector must send `Authorization: Bearer
# <this value>`. /health is always unauthenticated. This is a spike smoke-test credential,
# not OAuth; per-user OAuth 2.1 is a documented future step, not built here.
MCP_AUTH_TOKEN=

# Escape hatch to run http with no auth. Local testing only — never on a reachable address.
MCP_ALLOW_ANONYMOUS=

# Return a single JSON response instead of an SSE stream. Leave off unless a client needs it.
MCP_JSON_RESPONSE=

# Stateless HTTP: no per-session tracking or resumability. Off by default (one instance per
# client). Turn on only for horizontal scaling behind a load balancer (not needed for the spike).
MCP_STATELESS_HTTP=

# NOTE: under http, write tools default OFF (SUGAR_READ_ONLY is forced to 1 unless you set it
# explicitly). Set SUGAR_READ_ONLY=0 above to allow writes over http.
